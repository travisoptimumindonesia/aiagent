# Generate initial values with: bash scripts/setup.sh
DOMAIN=belajar.example.com
PUBLIC_URL=https://belajar.example.com
ACME_EMAIL=admin@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SERVICE_TOKEN=
AI_DAILY_LIMIT=40

# Provider compatible with POST /chat/completions; use its documented URL/model.
# Example DeepSeek: https://api.deepseek.com, model deepseek-chat (verify account availability).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Blank disables OCR. To enable: http://ocr:8002 and docker compose --profile ocr up -d --build
OCR_URL=

# Meta WhatsApp Cloud API (Business number, not a WhatsApp Web session).
WA_PHONE_ID=
WA_PUBLIC_NUMBER=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=24.0

# Separate paid Mandarin pronunciation product; obtain core type from SpeechSuper.
# Do not use an English core type or infer tone scores from a transcript.
SPEECHSUPER_APP_KEY=
SPEECHSUPER_SECRET_KEY=
SPEECHSUPER_CORE_TYPE=
